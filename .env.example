# Copy this file to .env and fill in your real keys.
# IMPORTANT: Do not commit your real .env file to the repo.
 # After creating .env, restart the dev server (npm start) or rebuild (npm run build).

# Web3Forms (client-side key; public by design, but still unique to your account)
REACT_APP_WEB3FORMS_KEY=YOUR_REAL_WEB3FORMS_ACCESS_KEY

# Optional: use a hosted download URL for the Featured game (e.g., GitHub Release asset)
# Example: https://github.com/<owner>/<repo>/releases/download/<tag>/Touchy.7z
# REACT_APP_TOUCHY_RELEASE_URL=

# Optional: force-hide the Featured game download button (show "Download coming soon")
# Set to 1 or true to disable download
# REACT_APP_DISABLE_FEATURED_DOWNLOAD=1
