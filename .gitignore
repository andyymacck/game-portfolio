# Ignore local ffmpeg binaries and archives
tools/ffmpeg/
tools/ffmpeg/**
tools/ffmpeg/ffmpeg-*.zip

# Optional: ignore VS Code workspace junk
.vscode/

# Node/CRA typical ignores (if missing)
node_modules/
.DS_Store
*.log
npm-debug.log*
yarn-error.log
node_modules

# Do not commit build artifacts
build/

# Large files
public/unity/*.rar
build/unity/*.rar

# Environment files (keep only the example tracked)
.env
.env.*
*.env
!.env.example
